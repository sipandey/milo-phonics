# ============================================================
# GENERATION SCRIPT CREDENTIALS — NEVER COMMIT THIS FILE
# ============================================================

# OpenAI TTS — generation-time only, never goes in the browser
OPENAI_API_KEY=sk-...your-key-here...

# Cloudinary — API_SECRET is server-side only, never goes in the browser
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# TTS GENERATION CONFIG
# ============================================================
TTS_MODEL=gpt-4o-mini-tts
AUDIO_TTS_VOICE=coral
# Instruction config version — bump when you change TTS instructions
TTS_INSTRUCTION_VERSION=1

# Clerk Authentication (Parent Cloud Sync)
# Get your key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# ============================================================
# SENTRY BROWSER MONITORING
# ============================================================
# Public browser DSN from the Sentry `milo-phonics` project. Keep the value in
# deployment configuration when possible; never put an auth token in VITE_*.
VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
VITE_SENTRY_RELEASE=phonics@1.0.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-time source-map upload — never expose this token with a VITE_ prefix.
SENTRY_ORG=personal-df4
SENTRY_PROJECT=milo-phonics
SENTRY_AUTH_TOKEN=sntrys_...your-organization-token...
