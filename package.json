{
  "name": "phonics-toddler-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run verify:claims && vite build && npm run generate:service-worker",
    "verify:claims": "node --experimental-strip-types scripts/verify-claims.ts",
    "sbom:spdx": "npm sbom --package-lock-only --sbom-format=spdx --sbom-type=application",
    "verify:release": "tsx scripts/verify-release.ts",
    "verify:curriculum": "tsx scripts/verify-curriculum.ts",
    "lint": "eslint src tests scripts/serviceWorker.ts scripts/generate-service-worker.ts vite.config.ts vitest.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "agent-room:validate": "create-agent-room validate .",
    "agent-room:doctor": "create-agent-room doctor .",
    "agent-room:metrics": "create-agent-room metrics .",
    "generate:service-worker": "node --experimental-strip-types scripts/generate-service-worker.ts",
    "generate:audio": "tsx scripts/generate-audio.ts",
    "generate:audio:dry-run": "tsx scripts/generate-audio.ts --dry-run"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@sentry/react": "^11.7.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cloudinary": "^2.6.1",
    "create-agent-room": "^2.3.1",
    "dotenv": "^16.5.0",
    "eslint": "^10.12.0",
    "openai": "^4.x",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.x",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
